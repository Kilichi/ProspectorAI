# Copiar solo si backend/.env no existe. Nunca subir las claves al repositorio.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/prospectorai
LOG_LEVEL=info

# Solo HTTP/HTTPS. Indicar contacto real para los servicios OSM y webs.
HTTP_USER_AGENT=ProspectorAI/1.0 (proyecto educativo; contacto: TU_EMAIL)

# Configuración IA, usada desde la Fase 3. Elegir groq o gemini y su modelo.
AI_PROVIDER=groq
# Ejemplo Groq; consultar https://console.groq.com/docs/models
# Para Gemini consultar https://ai.google.dev/gemini-api/docs/models
# Usar solo modelos disponibles en la cuota gratuita de la propia cuenta.
AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GEMINI_API_KEY=
# Pausa mínima entre llamadas (incluye correcciones y reintentos): 1000-60000 ms.
AI_DELAY_MS=3000
# Reintentos adicionales por 429, entre 0 y 3. Backoff 2, 4 y 8 segundos.
AI_MAX_RETRIES=2
# Empresas por job: 1-100. Jobs admitidos, contando activo + en cola: 1-20.
MAX_COMPANIES_PER_RUN=15
MAX_PENDING_JOBS=5

# backend funciona sin n8n. Cambiar a n8n después de importar y publicar el workflow.
ORCHESTRATOR=backend
# Generar con npm run docker:prepare. Nunca reutilizar una API key como token.
ORCHESTRATOR_TOKEN=
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/buscar-empresas
# Datos institucionales opcionales; los ausentes se sustituyen por marcadores.
SCHOOL_NAME=
TEACHER_NAME=
SCHOOL_EMAIL=
SCHOOL_PHONE=
